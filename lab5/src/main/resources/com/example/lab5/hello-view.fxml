<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" alignment="TOP_CENTER"
      style="-fx-background-color: #f0f4f8; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.lab5.HelloController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Заголовок -->
    <Label text="АНКЕТА СТУДЕНТА"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a; -fx-padding: 0 0 5 0;"/>

    <!-- Карточка с основными полями -->
    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">
        <GridPane hgap="10" vgap="10">
            <Label text="ФИО*:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <TextField fx:id="txtFullName" promptText="Введите ФИО" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;"/>

            <Label text="Email*:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <TextField fx:id="txtEmail" promptText="example@mail.com" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;"/>

            <Label text="Группа*:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <TextField fx:id="txtGroup" promptText="ИТ-21" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;"/>

            <Label text="Город:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <ComboBox fx:id="cbCity" promptText="Выберите город" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity"
                      style="-fx-background-radius: 5;"/>

            <Label text="Дата рождения:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <DatePicker fx:id="dpBirthDate" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>
        </GridPane>
    </VBox>

    <!-- Выбор курса и формы обучения -->
    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">
        <fx:define>
            <ToggleGroup fx:id="courseGroup"/>
            <ToggleGroup fx:id="studyFormGroup"/>
        </fx:define>

        <VBox spacing="5">
            <Label text="Курс:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
            <HBox spacing="15">
                <RadioButton fx:id="rbCourse1" text="1" toggleGroup="$courseGroup"/>
                <RadioButton fx:id="rbCourse2" text="2" toggleGroup="$courseGroup"/>
                <RadioButton fx:id="rbCourse3" text="3" toggleGroup="$courseGroup"/>
                <RadioButton fx:id="rbCourse4" text="4" toggleGroup="$courseGroup"/>
            </HBox>
        </VBox>

        <Separator/>

        <VBox spacing="5">
            <Label text="Форма обучения:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
            <HBox spacing="15">
                <RadioButton fx:id="rbFullTime" text="Очная" toggleGroup="$studyFormGroup"/>
                <RadioButton fx:id="rbOnline" text="Дистанционная" toggleGroup="$studyFormGroup"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Дополнительно и Согласие -->
    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">
        <Label text="Дополнительно:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
        <HBox spacing="15">
            <CheckBox fx:id="chkDormitory" text="Общежитие"/>
            <CheckBox fx:id="chkScholarship" text="Стипендия"/>
            <CheckBox fx:id="chkActivist" text="Активист"/>
        </HBox>
        <Separator/>
        <CheckBox fx:id="chkConsent" text="Согласен на обработку персональных данных*" style="-fx-font-weight: bold; -fx-text-fill: #0f766e;"/>
    </VBox>

    <!-- Кнопки управления -->
    <HBox spacing="12" alignment="CENTER" style="-fx-padding: 5 0 5 0;">
        <Button fx:id="btnCreate" text="Сформировать" onAction="#onCreateClick"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Button text="Очистить" onAction="#onClearClick"
                style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Button text="Выход" onAction="#onExitClick"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
    </HBox>

    <!-- Результат -->
    <VBox spacing="5" style="-fx-background-color: #e0f2fe; -fx-background-radius: 10; -fx-padding: 12; -fx-border-color: #38bdf8; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
        <Label text="Результат:" style="-fx-font-weight: bold; -fx-text-fill: #0369a1;"/>
        <Label fx:id="lblResult" text="Анкета не заполнена" wrapText="true" style="-fx-text-fill: #0c4a6e;"/>
    </VBox>
</VBox>