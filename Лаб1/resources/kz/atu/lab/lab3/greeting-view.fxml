<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="java.kz.atu.lab.lab3.GreetingController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="Введите ваши данные" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <Label text="Имя:" />
        <TextField fx:id="txtFirstName" promptText="Введите имя" prefWidth="250.0" />
        <Label text="Фамилия:" />
        <TextField fx:id="txtLastName" promptText="Введите фамилию" prefWidth="250.0" />
        <Button text="Поприветствовать" onAction="#onGreetClick" prefWidth="200.0" style="-fx-font-size: 16px;" />
        <Label fx:id="lblResult" text="Приветствие появится здесь" style="-fx-font-size: 18px; -fx-text-fill: #2c3e50;" />
    </children>
</VBox>