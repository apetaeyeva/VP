<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="java.kz.atu.lab.lab2.ButtonController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label fx:id="lblOutput" text="Нажмите кнопку" style="-fx-font-size: 20px; -fx-text-fill: #2c3e50;">
            <font>
                <Font size="20.0" />
            </font>
        </Label>
        <Label text="-" />
        <Button fx:id="btnGreeting" text="Приветствие" onAction="#onGreetingClick" prefWidth="150.0" style="-fx-font-size: 16px;" />
        <Button fx:id="btnInfo" text="Информация" onAction="#onInfoClick" prefWidth="150.0" style="-fx-font-size: 16px;" />
        <Button fx:id="btnExit" text="Выход" onAction="#onExitClick" prefWidth="150.0" style="-fx-font-size: 16px; -fx-background-color: #e74c3c; -fx-text-fill: white;" />
    </children>
</VBox>