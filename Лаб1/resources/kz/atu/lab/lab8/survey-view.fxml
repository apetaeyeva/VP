<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="java.kz.atu.lab.lab8.SurveyController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="АНКЕТА ПОЛЬЗОВАТЕЛЯ" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        
        <GridPane hgap="10.0" vgap="10.0" alignment="CENTER">
            <children>
                <Label text="ФИО:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtName" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200.0" />
                
                <Label text="Город:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="comboCity" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200.0" />
                
                <Label text="Пол:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <GridPane GridPane.columnIndex="1" GridPane.rowIndex="2" hgap="10.0">
                    <children>
                        <RadioButton fx:id="rbMale" text="Мужской">
                            <toggleGroup><ToggleGroup fx:id="genderGroup" /></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbFemale" text="Женский" toggleGroup="$genderGroup" GridPane.column