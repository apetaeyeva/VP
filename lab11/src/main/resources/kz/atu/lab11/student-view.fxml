<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kz.atu.lab11.controller.StudentController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="10"/>
            </padding>
            <Label text="Поиск по ФИО:"/>
            <TextField fx:id="txtSearch" promptText="Введите имя" HBox.hgrow="ALWAYS"/>
            <Label text="Группа:"/>
            <ComboBox fx:id="cmbGroupFilter" prefWidth="130"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableStudents">
            <columns>
                <TableColumn fx:id="colName" text="ФИО" prefWidth="300"/>
                <TableColumn fx:id="colGroup" text="Группа" prefWidth="150"/>
                <TableColumn fx:id="colGpa" text="GPA" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets top="10"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblCount" text="Найдено студентов: 0"/>
                <Label fx:id="lblAvg" text="Средний GPA: 0.00"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtName" promptText="ФИО" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtGroup" promptText="Группа" prefWidth="110"/>
                <TextField fx:id="txtGpa" promptText="GPA (0–4)" prefWidth="90"/>
            </HBox>
            <HBox spacing="10">
                <Button text="Добавить" onAction="#onAdd"/>
                <Button text="Изменить" onAction="#onUpdate"/>
                <Button text="Удалить" onAction="#onDelete"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
