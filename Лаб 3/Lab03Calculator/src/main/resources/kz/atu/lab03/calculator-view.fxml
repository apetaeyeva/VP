<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.atu.lab03.CalculatorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="ИНТЕРАКТИВНЫЙ КАЛЬКУЛЯТОР" />

    <GridPane hgap="10.0" vgap="10.0">
        <children>
            <Label text="Первое число:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNumber1" promptText="Первое число" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Второе число:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtNumber2" promptText="Второе число" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        </children>
    </GridPane>

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Button fx:id="btnAdd" onAction="#onOperation" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" text="+" prefWidth="40" />
            <Button fx:id="btnSubtract" onAction="#onOperation" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" text="-" prefWidth="40" />
            <Button fx:id="btnMultiply" onAction="#onOperation" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" text="x" prefWidth="40" />
            <Button fx:id="btnDivide" onAction="#onOperation" onMouseEntered="#onMouseEntered" onMouseExited="#onMouseExited" text="÷" prefWidth="40" />
        </children>
    </HBox>

    <Label fx:id="lblResult" style="-fx-font-size: 14px;" text="Результат: 0" />
    <Label fx:id="lblOperation" style="-fx-font-size: 14px;" text="Операция: -" />

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Button fx:id="btnClear" onAction="#onClearClick" text="Очистить" />
            <Button fx:id="btnExit" onAction="#onExitClick" text="Выход" />
        </children>
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Button onAction="#onLockClick" text="Блокировать" />
            <Button onAction="#onUnlockClick" text="Разблокировать" />
        </children>
    </HBox>
</VBox>