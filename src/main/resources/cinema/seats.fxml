<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinema.controller.SeatController">
    <padding>
        <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
    </padding>
    <children>
        <Label fx:id="titleLabel" styleClass="section-title" text="Фильм" />
        <Label fx:id="infoLabel" text="Сеанс" />
        <Label maxWidth="420.0" styleClass="screen" text="ЭКРАН" />
        <GridPane fx:id="seatGrid" alignment="CENTER" hgap="6.0" vgap="6.0" />
        <HBox alignment="CENTER" spacing="14.0">
            <children>
                <Label styleClass="legend-free" text="Свободно" />
                <Label styleClass="legend-selected" text="Выбрано" />
                <Label styleClass="legend-taken" text="Занято" />
                <Label styleClass="legend-vip" text="VIP (+50%)" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Тип билета:" />
                <ComboBox fx:id="ticketCombo" prefWidth="200.0" />
            </children>
        </HBox>
        <Label fx:id="chosenLabel" wrapText="true" />
        <Label fx:id="totalLabel" styleClass="total" />
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="confirmButton" defaultButton="true" onAction="#onConfirm" styleClass="accent" text="Купить" />
                <Button cancelButton="true" onAction="#onCancel" text="Отмена" />
            </children>
        </HBox>
    </children>
</VBox>