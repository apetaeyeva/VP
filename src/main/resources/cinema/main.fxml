<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1020.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinema.controller.MainController">
    <top>
        <VBox>
            <children>
                <MenuBar>
                    <menus>
                        <Menu text="Файл">
                            <items>
                                <MenuItem onAction="#onSave" text="Сохранить">
                                    <accelerator>
                                        <KeyCodeCombination alt="UP" code="S" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                                    </accelerator>
                                </MenuItem>
                                <MenuItem onAction="#onResetDemo" text="Сбросить демо-данные" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#onExit" text="Выход">
                                    <accelerator>
                                        <KeyCodeCombination alt="UP" code="Q" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                                    </accelerator>
                                </MenuItem>
                            </items>
                        </Menu>
                        <Menu text="Фильм">
                            <items>
                                <MenuItem onAction="#onAddMovie" text="Добавить…">
                                    <accelerator>
                                        <KeyCodeCombination alt="UP" code="N" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                                    </accelerator>
                                </MenuItem>
                                <MenuItem onAction="#onEditMovie" text="Изменить…">
                                    <accelerator>
                                        <KeyCodeCombination alt="UP" code="E" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                                    </accelerator>
                                </MenuItem>
                                <MenuItem onAction="#onDeleteMovie" text="Удалить">
                                    <accelerator>
                                        <KeyCodeCombination alt="UP" code="D" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                                    </accelerator>
                                </MenuItem>
                                <SeparatorMenuItem />
                                <MenuItem onAction="#onFocusSearch" text="Найти">
                                    <accelerator>
                                        <KeyCodeCombination alt="UP" code="F" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                                    </accelerator>
                                </MenuItem>
                            </items>
                        </Menu>
                        <Menu text="Сеанс">
                            <items>
                                <MenuItem onAction="#onBook" text="Купить билеты…">
                                    <accelerator>
                                        <KeyCodeCombination alt="UP" code="B" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                                    </accelerator>
                                </MenuItem>
                                <MenuItem onAction="#onAddSession" text="Добавить сеанс…">
                                    <accelerator>
                                        <KeyCodeCombination alt="UP" code="T" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                                    </accelerator>
                                </MenuItem>
                                <MenuItem onAction="#onDeleteSession" text="Удалить сеанс" />
                            </items>
                        </Menu>
                        <Menu text="Справка">
                            <items>
                                <MenuItem onAction="#onAbout" text="О программе" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <ToolBar>
                    <items>
                        <Button onAction="#onAddMovie" text="＋ Фильм" />
                        <Button onAction="#onEditMovie" text="Изменить" />
                        <Button onAction="#onDeleteMovie" text="Удалить" />
                        <Separator orientation="VERTICAL" />
                        <Button onAction="#onBook" styleClass="accent" text="🎟 Купить билеты" />
                        <Separator orientation="VERTICAL" />
                        <Label text="Поиск:" />
                        <TextField fx:id="searchField" prefWidth="200.0" promptText="Название фильма" />
                        <Label text="Жанр:" />
                        <ComboBox fx:id="genreFilter" prefWidth="160.0" />
                        <Button onAction="#onResetFilter" text="Сбросить" />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.62" BorderPane.alignment="CENTER">
            <items>
                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="8.0" left="8.0" right="4.0" top="8.0" />
                    </padding>
                    <children>
                        <Label styleClass="section-title" text="Фильмы в прокате" />
                        <TableView fx:id="movieTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTitle" prefWidth="220.0" text="Название" />
                                <TableColumn fx:id="colGenre" prefWidth="110.0" text="Жанр" />
                                <TableColumn fx:id="colDuration" prefWidth="80.0" text="Длит." />
                                <TableColumn fx:id="colAge" prefWidth="60.0" text="Возраст" />
                                <TableColumn fx:id="colPrice" prefWidth="90.0" text="Цена" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="8.0" left="4.0" right="8.0" top="8.0" />
                    </padding>
                    <children>
                        <Label fx:id="sessionsTitle" styleClass="section-title" text="Сеансы" />
                        <ListView fx:id="sessionList" VBox.vgrow="ALWAYS" />
                        <HBox spacing="8.0">
                            <children>
                                <Button onAction="#onAddSession" text="Добавить сеанс" />
                                <Button onAction="#onDeleteSession" text="Удалить сеанс" />
                                <Button maxWidth="1.7976931348623157E308" onAction="#onBook" styleClass="accent" text="Выбрать места" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox spacing="20.0" styleClass="status-bar">
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
            <children>
                <Label fx:id="statusLabel" text="Готово" HBox.hgrow="ALWAYS" />
                <Label fx:id="statsLabel" />
            </children>
        </HBox>
    </bottom>
</BorderPane>