<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="kz.atu.lab06.CatalogController">
    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Каталог товаров"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch" promptText="Поиск по названию..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbFilterCategory" prefWidth="150.0"/>
                <Button onAction="#onClearFilterClick" text="Очистить фильтр"/>
            </HBox>
        </VBox>
    </top>
    <left>
        <VBox spacing="5.0" prefWidth="150.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="10.0" right="5.0"/>
            </padding>
            <Label text="Категории:" style="-fx-font-weight: bold;"/>
            <ListView fx:id="listCategories" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <center>
        <TableView fx:id="tableProducts" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colName" prefWidth="150.0" text="Название" />
                <TableColumn fx:id="colCategory" prefWidth="130.0" text="Категория" />
                <TableColumn fx:id="colPrice" prefWidth="100.0" text="Цена" />
                <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Количество" />
            </columns>
            <BorderPane.margin>
                <Insets left="5.0" right="10.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints maxWidth="120.0" minWidth="80.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                    <ColumnConstraints maxWidth="120.0" minWidth="80.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="30.0" prefHeight="30.0" />
                    <RowConstraints minHeight="30.0" prefHeight="30.0" />
                </rowConstraints>
                <children>
                    <Label text="Название:" />
                    <Label text="Категория:" GridPane.rowIndex="1" />
                    <Label text="Цена:" GridPane.columnIndex="2" />
                    <Label text="Количество:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <TextField fx:id="txtName" GridPane.columnIndex="1" />
                    <ComboBox fx:id="cmbCategory" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <TextField fx:id="txtPrice" GridPane.columnIndex="3" />
                    <TextField fx:id="txtQuantity" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </children>
            </GridPane>
            <HBox spacing="15.0" alignment="CENTER_RIGHT">
                <Label fx:id="lblCount" text="Найдено записей: 0" style="-fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onAddClick" prefWidth="100.0" text="Добавить" style="-fx-base: #2ecc71;"/>
                <Button onAction="#onDeleteClick" prefWidth="100.0" text="Удалить" style="-fx-base: #e74c3c;"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
