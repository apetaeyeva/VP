<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="java.kz.atu.lab.lab7.PurchaseController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="РАСЧЁТ СТОИМОСТИ ПОКУПКИ" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <GridPane hgap="10.0" vgap="10.0" alignment="CENTER">
            <children>
                <Label text="Товар:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtProduct" promptText="Наименование товара" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200.0" />
                <Label text="Цена (₸):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtPrice" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200.0" />
                <Label text="Количество:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Spinner fx:id="spinnerQuantity" min="1" max="100" initialValue="1" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="200.0" />
            </children>
        </GridPane>
        <Button text="Рассчитать стоимость" onAction="#onCalculateClick" prefWidth="200.0" />
        <Label fx:id="lblResult" text="" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <Label fx:id="lblError" text="" style="-fx-font-size: 14px; -fx-text-fill: #e74c3c;" />
    </children>
</VBox>