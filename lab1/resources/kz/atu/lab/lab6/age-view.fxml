<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="java.kz.atu.lab.lab6.AgeController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="РАСЧЁТ ВОЗРАСТА" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
        <Label text="Введите год рождения:" />
        <TextField fx:id="txtBirthYear" promptText="например, 2000" prefWidth="200.0" />
        <Button text="Рассчитать возраст" onAction="#onCalculateClick" prefWidth="200.0" />
        <Label fx:id="lblResult" text="" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    </children>
</VBox>